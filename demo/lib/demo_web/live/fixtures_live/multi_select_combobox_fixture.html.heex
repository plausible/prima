<form>
  <.combobox
    id="demo-multi-select-combobox"
    multiple={true}
    name="demo-multi-select-combobox[fruits][]"
  >
    <div id="demo-multi-select-combobox-field">
      <.combobox_selections>
        <:selection>
          <.combobox_selection_label />
          <.combobox_selection_remove>
            ×
          </.combobox_selection_remove>
        </:selection>
      </.combobox_selections>

      <.combobox_input placeholder="Select fruits..." />
    </div>

    <.combobox_options
      id="demo-multi-select-combobox-options"
      reference="#demo-multi-select-combobox-field"
    >
      <%= for option <- ["Apple", "Banana", "Cherry", "Mango"] do %>
        <.combobox_option value={option}>{option}</.combobox_option>
      <% end %>
    </.combobox_options>
  </.combobox>
</form>
