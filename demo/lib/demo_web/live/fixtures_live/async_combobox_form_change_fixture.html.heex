<form phx-change="form_changed">
  <.combobox
    :let={input_value}
    id="async-form-change-combobox"
    name="fruit"
    selections={@selected_fruit && %{value: @selected_fruit}}
  >
    <.combobox_input
      value={input_value}
      on_search="async_combobox_search"
      placeholder="Type to search..."
    />

    <.combobox_options
      phx-update="stream"
      class="w-64 py-1"
      id="async-form-change-options"
    >
      <%= for {id, option} <- @streams.suggestions do %>
        <.combobox_option
          id={id}
          value={option}
        >
          {option}
        </.combobox_option>
      <% end %>
    </.combobox_options>
  </.combobox>

  <div id="change-count" data-testid="change-count">
    Form changes: {@form_change_count}
  </div>
</form>
